{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Debug",
        "Microsoft.AspNetCore.Routing": "Debug",
        "Microsoft.AspNetCore.Hosting": "Debug"
      }
    },
    // Order of loggers matters! CI/CD pipeline will replace values for loggers based on an index
    "WriteTo": [
      {
        "Name": "Console"
      },
      { 
        "Name": "Seq",
        "Args": {
          "serverUrl": "TO_BE_REPLACED"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "CatalogDatabase": "TO_BE_REPLACED"
  },
  "OpenApi": {
    "OAuth2": {
      "AuthorizationUrl": "TO_BE_REPLACED",
      "TokenUrl": "TO_BE_REPLACED",
      "ClientId": "TO_BE_REPLACED"
    }
  },
  "OAuth20": {
    "Authority": "TO_BE_REPLACED",
    "Audience": "catalog-api",
    "RequireHttpsMetadata": "true"
  }
}
