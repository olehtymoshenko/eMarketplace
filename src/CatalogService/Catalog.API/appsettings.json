{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    // Order of loggers matters! CI/CD pipeline will replace values for loggers based on an index
    "WriteTo": [
      {
        "Name": "Console"
      },
      { 
        "Name": "Seq",
        "Args": {
          "serverUrl": "TO_BE_REPLACED"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "CatalogDatabase": "TO_BE_REPLACED"
  }
}
